{
  "subject": "Reset your StoryKeep password",
  "blocks": [
    {
      "type": "text",
      "content": "Hi {{.DisplayName}},",
      "align": "left",
      "color": "#111827",
      "isBold": false
    },
    {
      "type": "text",
      "content": "Click the button below to set a new password. This link expires in {{.ExpiresMinutes}} minutes.",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "divider",
      "color": "#E5E7EB"
    },
    {
      "type": "button",
      "label": "Reset Password",
      "url": "{{.ResetURL}}",
      "bgColor": "#2563EB",
      "textColor": "#FFFFFF"
    }
  ]
}

    {
      "type": "text",
      "content": "Hi {{.LeadName}}, your remote booking is confirmed!",
      "align": "center",
      "color": "#111827",
      "isBold": true
    },
    {
      "type": "divider",
      "color": "#E5E7EB"
    },
    {
      "type": "text",
      "content": "Booking ID: {{.BookingID}}",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "text",
      "content": "When: {{.BookingStartDisplay}} to {{.BookingEndDisplay}} ({{.BookingTimezone}})",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "text",
      "content": "{{.ServicesDisplay}}",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "text",
      "content": "{{.PickupProductsDisplay}}",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "text",
      "content": "Join link: {{.GoogleMeetURL}}",
      "align": "left",
      "color": "#111827",
      "isBold": false
    },
    {
      "type": "text",
      "content": "Order #: {{.ShopifyOrderID}}",
      "align": "left",
      "color": "#374151",
      "isBold": false
    },
    {
      "type": "button",
